# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:3000

# Single-user Authentication
# Use this token in the header: Authorization: Bearer <AUTH_TOKEN>
# Or pass as master password to POST /api/auth/login
AUTH_TOKEN=sanctuary-secret-token-change-me

# PostgreSQL Connection String
DATABASE_URL=postgresql://bookmark_user:bookmark_secret@localhost:5432/bookmark_sanctuary

# Gemini AI API Key (from Google AI Studio)
GEMINI_API_KEY=
